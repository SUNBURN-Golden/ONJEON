{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge.conflict.resolved.schema.json",
  "title": "KnowledgeConflictResolvedEvent",
  "type": "object",
  "description": "도메인 이벤트 knowledge.conflict.resolved (02_구현계약 §3.1, C-21). 내부 큐. 개인정보 없음.",
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "knowledge.conflict.resolved"
      ]
    },
    "event_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "payload": {
      "type": "object",
      "properties": {
        "conflict_id": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "assertion_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/AssertionId"
          }
        }
      },
      "required": [
        "conflict_id",
        "assertion_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event",
    "event_id",
    "occurred_at",
    "payload"
  ],
  "additionalProperties": false
}
