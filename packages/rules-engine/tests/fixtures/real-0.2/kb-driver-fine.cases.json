        "eligibility": "true",
        "payout": {"kind": "payable", "amount": {"kind": "unknown"}},
        "missing_inputs": ["other_contracts_liability_krw"]
      }
    },
    {
      "id": "unconfirmed_fine",
      "set": {"fine_final_krw": null},
      "expect": {
        "eligibility": "true",
        "payout": {"kind": "payable", "amount": {"kind": "unknown"}},
