{
  "amount": {
    "else": "insured_amount_krw",
    "if": {
      "all": [
        {
          "eq": [
            "is_initial_contract",
            true
          ]
        },
        {
          "lt": [
            "diagnosis_date",
            {
              "date_add": [
                "contract_date",
                {
                  "month_end": "clamp",
                  "unit": "calendar_year",
                  "value": 1
                }
              ]
            }
          ]
        }
      ]
    },
    "then": {
      "multiply_rate": [
        "insured_amount_krw",
        "0.5",
        {
          "rounding": "unspecified",
          "unit": 1
        }
      ]
    }
  },
  "calendar": "Asia/Seoul",
  "eligibility": {
    "all": [
      {
        "gte": [
          "diagnosis_date",
          {
            "else": "renewal_date",
            "if": "is_initial_contract",
            "then": {
              "date_add": [
                "contract_date",
                {
                  "unit": "day",
                  "value": 90
                }
              ]
            }
          }
        ]
      },
      {
        "lte": [
          "diagnosis_date",
          "policy_end_date"
        ]
      },
      {
        "eq": [
          "dx_in_category",
          true
        ]
      },
      {
        "eq": [
          "already_paid",
          false
        ]
      }
    ]
  },
  "evidence_refs": [
    "hana_2601_3d#c_2_1_art1_1",
    "hana_2601_3d#c_2_1_art1_2",
    "hana_2601_3d#c_2_1_art4_1",
    "hana_2601_3d#annex1",
    "hana_2601_3d#annex12"
  ],
  "example_kind": "ontology_case_validation",
  "inputs": {
    "already_paid": "bool",
    "contract_date": "date",
    "diagnosis_date": "date",
    "dx_in_category": "bool",
    "insured_amount_krw": "money_krw",
    "is_initial_contract": "bool",
    "policy_end_date": "date",
    "renewal_date": "date"
  },
  "inputs_from_outside_dsl": [
    {
      "as_of_fact": "diagnosis_date",
      "code_fact": "dx_code",
      "evidence_required": true,
      "judged_by": "ontology",
      "name": "dx_in_category"
    }
  ],
  "publication_state": "fixture_only",
  "rule_id": "hana-2601-3d-cancer-dx",
  "rule_version": "v1-ontology-case",
  "schema_version": "rule-0.1",
  "unknown_policy": "use_three_valued_logic_never_default_to_zero"
}