+
+#[test]
+fn artifact_loader_rejects_duplicate_keys_before_extracting_the_declaration() {
+    let plain = std::fs::read(golden_dir().join("규칙/hana-2601-3d-cancer-dx.json")).unwrap();
+    let value: Value = serde_json::from_slice(&plain).unwrap();
+    let text = serde_json::to_string(&value).unwrap();
+    let prefix = &text[..text.len() - 1];
+    for (extra, key) in [
+        (r#""amount":{"krw":1},"amount":{"krw":999}"#, "amount"),
+        (r#""example_kind":{"nested":[{"krw":1,"krw":999}]}"#, "krw"),
+        (
+            r#""inputs_from_outside_dsl":[],"inputs_from_outside_dsl":null"#,
+            "inputs_from_outside_dsl",
+        ),
+        (
+            r#""inputs_from_outside_dsl":null,"\u0069nputs_from_outside_dsl":[]"#,
+            "inputs_from_outside_dsl",
+        ),
+        (
+            r#""inputs_from_outside_dsl":[{"name":"x","name":"y","judged_by":"ontology"}]"#,
+            "name",
+        ),
+        (
+            r#""inputs_from_outside_dsl":[{"name":"x","judged_by":"ontology","duration":{"value":1,"value":2,"unit":"day"}}]"#,
+            "value",
+        ),
+    ] {
+        let text = format!("{prefix},{extra}}}");
+        let err = load_rule_artifact(text.as_bytes()).unwrap_err();
+        assert!(
+            err.contains(&format!("duplicate JSON key {key:?}")),
+            "{err}"
+        );
+    }
+}
