      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 20000000}}, "missing_inputs": []} },
    { "id": "f03_dui_excluded", "set": {"dui_unlicensed_or_drugs": true},
      "expect": {"eligibility": "false", "payout": {"kind": "not_payable"}, "missing_inputs": []} },
    { "id": "f04_other_contracts_need_prorata", "note": "다른 계약이 있으면 개인 가입내역 없이는 금액 판단 불가", "set": {"has_other_contracts": true},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "unknown"}}, "missing_inputs": ["pro_rata_amount_krw"]} },
    { "id": "f05_fine_not_final_yet", "note": "확정판결 전에는 벌금액 미확정", "set": {"fine_final_krw": null},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "unknown"}}, "missing_inputs": ["fine_final_krw"]} }
  ]
