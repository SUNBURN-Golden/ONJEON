# 로컬 Compose 환경 변수 예시. 비밀값 없음.
# up.sh가 이 파일을 .env로 복사하고, 비어 있는 *_PASSWORD, *_SECRET_KEY, *_ACCESS_KEY를 무작위 값으로 채운다.
# .env는 Git에 올리지 않는다(.gitignore). 값을 손으로 채울 때도 이 파일에는 쓰지 않는다.

COMPOSE_PROJECT_NAME=onjeon-local

# 호스트에 여는 포트. 전부 127.0.0.1에만 묶인다. 비워 두면 임의 포트.
PUBLIC_DB_PORT=15432
PRIVATE_DB_PORT=15433
S3_API_PORT=18333

# 공개 영역 DB: 공시 코퍼스·릴리스(L0~L7). 개인 자료 금지.
PUBLIC_DB_NAME=onjeon_public
PUBLIC_DB_ADMIN_USER=onjeon_pub_admin
PUBLIC_DB_ADMIN_PASSWORD=
PUBLIC_DB_APP_USER=onjeon_pub_app
PUBLIC_DB_APP_PASSWORD=

# 개인 영역 DB: 계약 스냅샷·가정·동의(BLUEPRINT 4장). 공개 영역과 자격 증명을 공유하지 않는다.
PRIVATE_DB_NAME=onjeon_private
PRIVATE_DB_ADMIN_USER=onjeon_prv_admin
PRIVATE_DB_ADMIN_PASSWORD=
PRIVATE_DB_APP_USER=onjeon_prv_app
PRIVATE_DB_APP_PASSWORD=

# S3 호환 객체 저장소. 관리 자격은 버킷 생성과 시험 정리에만 쓴다.
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=
S3_PUBLIC_ACCESS_KEY=
S3_PUBLIC_SECRET_KEY=
S3_PRIVATE_ACCESS_KEY=
S3_PRIVATE_SECRET_KEY=

# 공개 영역 버킷 두 개(원본, 파생)와 개인 영역 버킷 하나.
S3_PUBLIC_RAW_BUCKET=onjeon-raw-sources
S3_PUBLIC_DERIVED_BUCKET=onjeon-derived-sources
S3_PRIVATE_BUCKET=onjeon-private-contracts
