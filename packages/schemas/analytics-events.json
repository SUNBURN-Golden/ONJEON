{
  "$comment": "분석 이벤트 허용 목록 (02_구현계약 §3.2, C-17). 검사: src/allowlist.rs(Rust)와 codegen/check_allowlist.py(Python, 누출 정적 검사가 가져다 쓴다). 두 검사기는 아래 examples를 똑같이 통과·거부해야 한다. 허용 목록 밖 필드는 보내지 않는다. contracts_version은 packages/schemas/Cargo.toml의 version과 같아야 한다(C-23).",
  "contracts_version": "0.1.0",
  "event_key": "event",
  "allowed_fields": {
    "screen_id": {
      "kind": "token",
      "max_len": 64,
      "meaning_ko": "화면 식별자(소문자 영문·숫자·_ . -). 사용자가 입력한 글자가 아니다"
    },
    "state_code": {
      "kind": "vocabulary",
      "axes": [
        "display_status",
        "capability_state",
        "freshness",
        "policy_holdings_status"
      ],
      "meaning_ko": "어휘 정본의 상태 값 하나"
    },
    "latency_ms": {
      "kind": "integer",
      "minimum": 0,
      "meaning_ko": "응답 시간(밀리초)"
    },
    "error_class": {
      "kind": "vocabulary",
      "axes": [
        "error_class"
      ],
      "meaning_ko": "오류 클래스 어휘 값 하나(validation·auth·not_found·…). ErrorResponse.error_class와 같은 값이며 코드의 클래스 글자(V A …)가 아니다. 글자와의 대응은 errors.json classes"
    },
    "release_id": {
      "kind": "release_id",
      "meaning_ko": "릴리스 ID rel:<yyyymmdd>-<n>"
    },
    "app_version": {
      "kind": "semver",
      "meaning_ko": "앱 버전 x.y.z"
    },
    "purpose": {
      "kind": "token",
      "max_len": 64,
      "only_events": [
        "consent_changed"
      ],
      "meaning_ko": "동의 목적 토큰. consent_changed에서만 허용(02 §3.2 이벤트 목록의 `purpose만`)"
    }
  },
