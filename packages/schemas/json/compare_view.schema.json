{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compare_view.schema.json",
  "title": "CompareView",
  "type": "object",
  "description": "비교 뷰모델. 확인 필요 상품도 같은 목록에 남는다 (02_구현계약 §2.1·§2.4)",
  "properties": {
    "release_id": {
      "$ref": "common.schema.json#/$defs/ReleaseId"
    },
    "comparison_basis_id": {
      "$ref": "common.schema.json#/$defs/Identifier",
      "description": "가격 비교 기준. 가격은 같은 기준 안에서만 비교한다"
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CompareColumn"
      }
    },
    "axes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CompareAxis"
      }
    },
    "scope_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScopeRelationEntry"
      }
    },
    "price": {
      "$ref": "#/$defs/ComparePrice"
    },
    "not_comparable_reasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NotComparableReason"
      }
    },
    "result_state": {
      "$ref": "common.schema.json#/$defs/ResultState"
    }
  },
  "required": [
    "release_id",
    "columns",
    "axes",
    "scope_relations",
    "not_comparable_reasons",
    "result_state"
  ],
  "additionalProperties": false,
  "$defs": {
    "CompareColumn": {
      "type": "object",
      "description": "비교 열 하나",
      "properties": {
        "sc_id": {
          "$ref": "common.schema.json#/$defs/SalesConfigId"
        },
        "cov_id": {
          "$ref": "common.schema.json#/$defs/CoverageId"
        },
        "capability_state": {
          "$ref": "vocabulary.schema.json#/$defs/capability_state"
        },
        "display_status": {
          "$ref": "vocabulary.schema.json#/$defs/display_status"
        }
      },
      "required": [
        "sc_id",
        "cov_id",
        "capability_state",
        "display_status"
      ],
      "additionalProperties": false
    },
    "CompareCell": {
      "type": "object",
      "description": "축 하나의 한 열 값",
      "properties": {
        "sc_id": {
          "$ref": "common.schema.json#/$defs/SalesConfigId"
        },
        "value": {
          "type": "string",
          "description": "화면에 보이는 값. 큰 금액 자리는 scenario: 출처만"
        },
        "evidence_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "x-onjeon-pending-axis": "evidence_kind",
          "description": "terms, summary, disclosure, user_input. 어휘 축 승격 대기"
        },
        "applicability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "x-onjeon-pending-axis": "applicability",
          "description": "applies, not_applies, unverified. 어휘 축 승격 대기"
        },
        "display_status": {
          "$ref": "vocabulary.schema.json#/$defs/display_status"
        },
        "amounts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Amount"
          }
        }
      },
      "required": [
        "sc_id",
        "value",
        "evidence_kind",
        "applicability",
        "display_status"
      ],
      "additionalProperties": false
    },
    "CompareAxis": {
      "type": "object",
      "description": "비교축 하나",
      "properties": {
        "concept_axis": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "per_column": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompareCell"
          }
        }
      },
      "required": [
        "concept_axis",
        "per_column"
      ],
      "additionalProperties": false
    },
    "ScopeRelationEntry": {
      "type": "object",
      "description": "범위 관계. derived만(계산, 코드 우주 해시)",
      "properties": {
        "a": {
          "$ref": "common.schema.json#/$defs/Identifier",
          "description": "열 식별자(sc_id 또는 cov_id)"
        },
        "b": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "value": {
          "$ref": "vocabulary.schema.json#/$defs/scope_relation",
          "description": "범위 관계 값(온톨로지 설계안 §13)"
        },
        "derived_from": {
          "$ref": "common.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "a",
        "b",
        "value",
        "derived_from"
      ],
      "additionalProperties": false
    },
    "UnpricedColumn": {
      "type": "object",
      "description": "가격 미확인 열. 목록에서 빠지지 않는다",
      "properties": {
        "sc_id": {
          "$ref": "common.schema.json#/$defs/SalesConfigId"
        },
        "reason": {
          "$ref": "vocabulary.schema.json#/$defs/price_unavailable_reason"
        }
      },
      "required": [
        "sc_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "ComparePrice": {
      "type": "object",
      "description": "같은 비교 기준 안의 가격",
      "properties": {
        "basis_id": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "comparable_columns": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/SalesConfigId"
          }
        },
        "unpriced_columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnpricedColumn"
          }
        }
      },
      "required": [
        "basis_id",
        "comparable_columns",
        "unpriced_columns"
      ],
      "additionalProperties": false
    },
    "NotComparableReason": {
      "type": "object",
      "description": "비교할 수 없는 이유",
      "properties": {
        "column": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "x-onjeon-pending-axis": "not_comparable_reason",
          "description": "비교 불가 이유 코드. 02에 값 집합이 없다. 어휘 축 승격 대기"
        }
      },
      "required": [
        "column",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
