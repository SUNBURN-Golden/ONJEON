    { "id": "s08_diagnosis_before_first_coverage_start", "set": {"first_coverage_start_date": "2026-06-02"},
      "expect": {"eligibility": "false", "payout": {"kind": "not_payable"}, "missing_inputs": []} },
    { "id": "s09_diagnosis_on_period_start", "set": {"period_start_date": "2026-06-01"},
