{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "criterion-file.schema.json",
  "title": "ONJEON criterion file (data/criteria/criteria/<slug>.json)",
  "description": "기준 항목 하나와 그 판들. 계약: 02_구현계약 §1.5, infra/db/criteria/01_criteria.sql. enum 값은 packages/schemas/vocabulary.json과 같다. default* 키는 어디에도 쓸 수 없다(T-KN-13 경로).",
  "type": "object",
  "required": ["criterion", "versions"],
  "additionalProperties": false,
  "properties": {
    "criterion": { "$ref": "#/$defs/criterion" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/version" }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": ["id", "kind", "label", "scope", "recorded_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^crit:[a-z0-9_-]+$" },
        "kind": {
          "type": "string",
          "enum": ["priority_rule", "reference_stat", "applicability_rule", "question_rule"]
        },
        "label": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["situations", "subjects"],
      "additionalProperties": false,
      "properties": {
        "situations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "subjects": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "version": {
      "type": "object",
      "required": ["version", "valid_from", "sources", "rationale", "recorded_at", "origin"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "valid_from": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "valid_to": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "supersedes": { "type": "string", "pattern": "^crit:[a-z0-9_-]+@[0-9]+$" },
        "correction_reason": {
          "type": "string",
          "enum": ["error_correction", "source_changed", "interpretation_improved", "rule_changed"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "rationale": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "string", "format": "date-time" },
        "origin": { "type": "string", "enum": ["pipeline", "fixture"] }
      }
    },
    "source": {
      "type": "object",
      "required": ["ref", "evidence_kind"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "description": "근거 참조: raw:sha256:<64hex> | clause:<seg 문법> | obs:src:<문법> (02 §6.1)",
          "pattern": "^(raw:sha256:[0-9a-f]{64}|clause:seg:[0-9a-f]{12,64}:p[0-9]+-[0-9]+:[a-z][a-z0-9_]*:[A-Za-z0-9._-]+/[^#[:space:]]+#p[0-9]+:[A-Za-z0-9._-]+@[A-Za-z0-9._-]+(@[0-9.]+,[0-9.]+,[0-9.]+,[0-9.]+)?|obs:src:[^/[:space:]]+/[^/[:space:]]+/[^/[:space:]]+/[^/[:space:]]+/[0-9a-f]{16})$"
        },
        "evidence_kind": {
          "type": "string",
          "enum": ["public_statistic", "statute", "regulator_notice", "terms_fact", "editorial"]
        }
      }
    }
  }
}
