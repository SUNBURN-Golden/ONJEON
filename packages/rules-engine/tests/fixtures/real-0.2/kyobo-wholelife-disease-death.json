{
  "example_kind": "real_clause_design_validation",
  "rule_id": "kyobo-wholelife-disease-death",
  "rule_version": "v2-validation",
  "schema_version": "rule-0.2",
  "calendar": "Asia/Seoul",
  "inputs": {
    "contract_date": "date",
    "coverage_start_date": "date",
    "is_revived": "bool",
    "revival_application_date": "date",
    "death_date": "date",
    "cause_in_accident_table": "bool",
    "self_harm": "bool",
    "self_harm_without_free_will": "bool",
    "harmed_by_beneficiary_or_contractor": "bool",
    "offender_is_partial_beneficiary_only": "bool",
    "claimant_is_other_beneficiary": "bool",
    "confirmed_claimant_share_krw": "money_krw",
    "basic_amount_krw": "money_krw",
    "insured_amount_krw": "money_krw",
    "additional_reserve_krw": "money_krw"
  },
  "eligibility": {
    "all": [
      {"gte": ["death_date", "contract_date"]},
      {"gte": ["death_date", "coverage_start_date"]},
      {
        "lt": [
          "death_date",
          {
            "date_add": ["contract_date", {"value": 5, "unit": "calendar_year", "month_end": "clamp"}]
          }
        ]
      },
      {
        "any": [
          {"all": [{"eq": ["cause_in_accident_table", false]}, {"eq": ["self_harm", false]}]},
          {
            "all": [
              {"eq": ["self_harm", true]},
              {"eq": ["self_harm_without_free_will", false]},
              {
                "gte": [
                  "death_date",
                  {
                    "if": "is_revived",
                    "then": {
                      "date_add": [
                        "revival_application_date",
                        {"value": 2, "unit": "calendar_year", "month_end": "clamp"}
                      ]
                    },
                    "else": {
                      "date_add": [
                        "coverage_start_date",
                        {"value": 2, "unit": "calendar_year", "month_end": "clamp"}
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "if": "harmed_by_beneficiary_or_contractor",
        "then": {"all": ["offender_is_partial_beneficiary_only", "claimant_is_other_beneficiary"]},
        "else": true
      }
    ]
  },
  "amount": {
    "if": "harmed_by_beneficiary_or_contractor",
    "then": "confirmed_claimant_share_krw",
    "else": {
      "add": [
        {"multiply_rate": ["basic_amount_krw", "0.5", {"rounding": "unspecified", "unit": 1}]},
        {
          "if": {
            "lt": [
              "death_date",
              {
                "date_add": ["contract_date", {"value": 1, "unit": "calendar_year", "month_end": "clamp"}]
              }
            ]
          },
          "then": {"krw": 0},
          "else": {
            "multiply_rate": [
              "insured_amount_krw",
              {
                "anniversary_band": [
                  "contract_date",
                  "death_date",
                  [[0, "0"], [1, "0.1"], [2, "0.2"], [3, "0.3"], [4, "0.4"]],
                  {"boundary": "lower_inclusive"}
                ]
              },
              {"rounding": "unspecified", "unit": 1}
            ]
          }
        },
        "additional_reserve_krw"
      ]
    }
  },
  "unknown_policy": "use_three_valued_logic_never_default_to_zero",
  "evidence_refs": [
    "kyobo_wholelife#c_art3",
    "kyobo_wholelife#c_art8_1",
    "kyobo_wholelife#c_art8_1_b",
    "kyobo_wholelife#c_art8_2_3",
    "kyobo_wholelife#c_annex1_period",
    "kyobo_wholelife#c_annex1_disease",
    "kyobo_wholelife#c_sum_disease_amount",
    "kyobo_wholelife#c_annex4_self_harm_excluded"
  ],
  "publication_state": "fixture_only"
}
