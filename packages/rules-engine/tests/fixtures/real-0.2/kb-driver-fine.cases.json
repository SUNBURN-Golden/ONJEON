  "cases": [
    {
      "id": "overlapping_liabilities",
      "set": {},
      "expect": {
        "eligibility": "true",
        "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 15000000}},
        "missing_inputs": []
      }
    },
    {
