{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "twin.shadow.compared.schema.json",
  "title": "TwinShadowComparedEvent",
  "type": "object",
  "description": "도메인 이벤트 twin.shadow.compared (02_구현계약 §3.1, C-21). 내부 큐. 개인정보 없음.",
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "twin.shadow.compared"
      ]
    },
    "event_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "payload": {
      "type": "object",
      "properties": {
        "old_release": {
          "$ref": "common.schema.json#/$defs/ReleaseId"
        },
        "new_release": {
          "$ref": "common.schema.json#/$defs/ReleaseId"
        },
        "diff_count": {
          "type": "integer",
          "minimum": 0,
          "description": "달라진 결과 수"
        },
        "unexplained_count": {
          "type": "integer",
          "minimum": 0,
          "description": "원인을 설명하지 못한 변화 수"
        }
      },
      "required": [
        "old_release",
        "new_release",
        "diff_count",
        "unexplained_count"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event",
    "event_id",
    "occurred_at",
    "payload"
  ],
  "additionalProperties": false
}
