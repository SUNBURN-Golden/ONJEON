{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "default-file.schema.json",
  "title": "ONJEON default-candidate file (data/criteria/defaults/candidates/<slug>.json)",
  "description": "기본 필요액·참고 통계 기본값 후보 항목 하나와 그 판들. 계약: 02_구현계약 §1.5 기본값 행, T-KN-13, D-08·O05. 출처는 확정된 공공 통계뿐(raw:sha256 RawAsset 해시 + public_statistic), 후보는 applied=false로만 적재된다.",
  "type": "object",
  "required": ["candidate", "versions"],
  "additionalProperties": false,
  "properties": {
    "candidate": { "$ref": "#/$defs/candidate" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/version" }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["id", "kind", "label", "scope", "update_cycle", "applied", "recorded_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^def:[a-z0-9_-]+$" },
        "kind": {
          "type": "string",
          "enum": ["needed_amount", "reference_stat"]
        },
        "label": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "update_cycle": { "$ref": "#/$defs/update_cycle" },
        "applied": { "type": "boolean", "const": false },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["situations", "subjects"],
      "additionalProperties": false,
      "properties": {
        "situations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "subjects": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "update_cycle": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly", "quarterly", "semiannual", "annual", "on_source_release", "irregular"]
        },
        "note": { "type": "string" }
      }
    },
    "version": {
      "type": "object",
      "required": ["version", "valid_from", "value", "sources", "rationale", "recorded_at", "origin"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "valid_from": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "valid_to": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "supersedes": { "type": "string", "pattern": "^def:[a-z0-9_-]+@[0-9]+$" },
        "correction_reason": {
          "type": "string",
          "enum": ["error_correction", "source_changed", "interpretation_improved", "rule_changed"]
        },
        "value": { "$ref": "#/$defs/value" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "rationale": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "string", "format": "date-time" },
        "origin": { "type": "string", "enum": ["pipeline", "fixture"] }
      }
    },
    "value": {
      "description": "후보 판이 담는 통계 값. kind 네 가지 중 하나 — 각 kind에 없는 키는 거부된다.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "amount_krw", "period", "summary"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "monetary_amount" },
            "amount_krw": { "type": "integer", "minimum": 0 },
            "period": { "type": "string", "enum": ["day", "month", "year", "case"] },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "rate_bp", "summary"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "rate" },
            "rate_bp": { "type": "integer", "minimum": 0 },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "count", "unit", "summary"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "count" },
            "count": { "type": "integer", "minimum": 0 },
            "unit": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "items", "summary"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "structure" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/structure_item" }
            },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "structure_item": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "amount_krw": { "type": "integer", "minimum": 0 },
        "rate_bp": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["ref", "evidence_kind"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "description": "보존된 공공 통계 원본의 RawAsset 해시 참조만 온다",
          "pattern": "^raw:sha256:[0-9a-f]{64}$"
        },
        "evidence_kind": {
          "type": "string",
          "const": "public_statistic",
          "description": "어휘 축 criterion_source_kind의 public_statistic 하나뿐이다"
        }
      }
    }
  }
}
