        "missing_inputs": []
      }
    },
    {
      "id": "sum_below_loss",
      "set": {"other_contracts_liability_krw": 9999999},
      "expect": {
        "eligibility": "true",
        "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 20000000}},
        "missing_inputs": []
      }
    },
    {
      "id": "sum_equals_loss",
      "set": {"other_contracts_liability_krw": 10000000},
      "expect": {
        "eligibility": "true",
        "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 20000000}},
        "missing_inputs": []
      }
    },
    {
      "id": "fractional_won",
      "set": {"fine_final_krw": 10, "other_contracts_liability_krw": 5},
      "expect": {
        "eligibility": "true",
        "payout": {"kind": "payable", "amount": {"kind": "range", "min_krw": 6, "max_krw": 7}},
        "missing_inputs": []
      }
    },
    {
      "id": "no_other_contract",
      "set": {"has_other_contracts": false, "other_contracts_liability_krw": null},
