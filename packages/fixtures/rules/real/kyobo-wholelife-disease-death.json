{
  "example_kind": "real_clause_design_validation",
  "rule_id": "kyobo-wholelife-disease-death",
  "rule_version": "v1-validation",
  "schema_version": "rule-0.1",
  "calendar": "Asia/Seoul",
  "inputs": {
    "contract_date": "date",
    "coverage_start_date": "date",
    "is_revived": "bool",
    "revival_application_date": "date",
    "death_date": "date",
    "cause_in_accident_table": "bool",
    "self_harm": "bool",
    "self_harm_without_free_will": "bool",
    "harmed_by_beneficiary_or_contractor": "bool",
    "basic_amount_krw": "money_krw",
    "insured_amount_krw": "money_krw",
    "additional_reserve_krw": "money_krw"
  },
  "eligibility": {
    "all": [
      { "lt": ["death_date", { "date_add": ["contract_date", { "value": 5, "unit": "calendar_year", "month_end": "clamp" }] }] },
      { "any": [
        { "all": [ { "eq": ["cause_in_accident_table", false] }, { "eq": ["self_harm", false] } ] },
        { "all": [
          { "eq": ["self_harm", true] },
          { "eq": ["self_harm_without_free_will", false] },
          { "gte": ["death_date", {
            "if": "is_revived",
            "then": { "date_add": ["revival_application_date", { "value": 2, "unit": "calendar_year", "month_end": "clamp" }] },
            "else": { "date_add": ["coverage_start_date", { "value": 2, "unit": "calendar_year", "month_end": "clamp" }] }
          }] }
        ] }
      ] },
      { "eq": ["harmed_by_beneficiary_or_contractor", false] }
    ]
  },
  "amount": {
    "add": [
      { "multiply_rate": ["basic_amount_krw", "0.5", { "rounding": "unspecified", "unit": 1 }] },
      { "if": { "lt": ["death_date", { "date_add": ["contract_date", { "value": 1, "unit": "calendar_year", "month_end": "clamp" }] }] },
        "then": { "krw": 0 },
        "else": { "if": { "lt": ["death_date", { "date_add": ["contract_date", { "value": 2, "unit": "calendar_year", "month_end": "clamp" }] }] },
          "then": { "multiply_rate": ["insured_amount_krw", "0.1", { "rounding": "unspecified", "unit": 1 }] },
          "else": { "if": { "lt": ["death_date", { "date_add": ["contract_date", { "value": 3, "unit": "calendar_year", "month_end": "clamp" }] }] },
            "then": { "multiply_rate": ["insured_amount_krw", "0.2", { "rounding": "unspecified", "unit": 1 }] },
            "else": { "if": { "lt": ["death_date", { "date_add": ["contract_date", { "value": 4, "unit": "calendar_year", "month_end": "clamp" }] }] },
              "then": { "multiply_rate": ["insured_amount_krw", "0.3", { "rounding": "unspecified", "unit": 1 }] },
              "else": { "multiply_rate": ["insured_amount_krw", "0.4", { "rounding": "unspecified", "unit": 1 }] } } } } },
      "additional_reserve_krw"
    ]
  },
  "unknown_policy": "use_three_valued_logic_never_default_to_zero",
  "evidence_refs": [
    "kyobo_wholelife#c_art3",
    "kyobo_wholelife#c_art8_1",
    "kyobo_wholelife#c_art8_1_b",
    "kyobo_wholelife#c_annex1_period",
    "kyobo_wholelife#c_annex1_disease",
    "kyobo_wholelife#c_sum_disease_amount",
    "kyobo_wholelife#c_annex4_self_harm_excluded"
  ],
  "publication_state": "fixture_only"
}
