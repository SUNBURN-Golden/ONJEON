    "time": "valid_from/valid_to(적용 기간), recorded_at(기록), observed_at(출처 관측), judged_as_of(판정 시점 규칙)",
    "evidence": "[{ref, role: basis|cross_check|observation}]",
    "criticality": "C0|C1|C2(SYSTEM_CONTRACT §7.2)",
    "value_state": "어휘 value_state",
    "review_status": "어휘 review_status",
    "hold_reason": "어휘 hold_reason",
    "supersedes": "이전 주장 ID(정정일 때)",
    "correction_reason": "오류 정정|출처 변경|해석 개선|규칙 변경",
    "origin": "pipeline|fixture. fixture는 시험 전용이며 서비스 릴리스에 들어갈 수 없다"
  },
  "constraints": [
    {
      "id": "K1",
      "rule": "현재(대체되지 않은) C0 내용 주장이 accepted이려면 basis 근거가 약관 구획(보통약관·특약 약관·별표)의 조항이고, 그 구획이 accepted realizes로 약관 본문 판에 이어져 있어야 한다. 요약서·공시·안내 쪽만 있으면 accepted가 될 수 없다(ADR-0014). 구조 주장(uses_edition·realizes·disclosure_of)은 관측 근거가 있어야 한다"
    },
    {
      "id": "K2",
      "rule": "same_benefit_as는 양쪽 약관 조항을 basis로 가진 대조 주장이 있어야 한다. 이름·코드 일치만으로 세우지 않는다"
    },
    {
      "id": "K3",
      "rule": "CodeSet은 코드 체계·개정차수·시행일·판정 시점 규칙을 가져야 한다"
    },
    {
      "id": "K4",
      "rule": "범위 관계 narrower/broader 주장(출처 주장 포함)에 순환이 없다"
    },
    {
      "id": "K5",
      "rule": "valid_from ≤ valid_to. 조건의 기산 시점은 TimeAnchor 어휘여야 한다"
    },
    {
      "id": "K6",
      "rule": "기간 단위(day·calendar_month·calendar_year)는 원문 그대로이며, 단위가 다른 기간을 같다고 주장하지 않는다"
    },
    {
      "id": "K7",
      "rule": "감액 조건은 적용 대상(최초/갱신/부활)을 가져야 observed가 된다"
    },
    {
      "id": "K8",
      "rule": "공개 영역의 어떤 노드·주장도 개인 영역 식별자(contract:, person:, upload:)를 참조하지 않는다"
    },
    {
      "id": "K9",
      "rule": "implemented_by로 연결된 규칙의 evidence_refs는 그 담보의 accepted C0 주장 basis 근거의 부분집합이다"
    },
    {
      "id": "K10",
      "rule": "supersedes는 선형이다. 같은 주장을 둘이 대체하면 Conflict가 기록되어 있어야 한다"
    },
    {
      "id": "K11",
      "rule": "담보에 해소되지 않은 Conflict나 hold인 C0 주장이 있으면 simulate가 blocked다"
    },
    {
      "id": "K12",
      "rule": "양쪽 범주의 코드 집합이 확정된(계산 가능한) 쌍에서는 scope_relation 주장 값이 코드 집합에서 계산한 값과 같아야 한다. 계산할 수 없는 쌍의 범위 관계는 출처 주장(observed)으로만 두고 accepted가 될 수 없다"
    },
    {
      "id": "K13",
      "rule": "가격 관측은 조건·구성(묶음 여부)·기준일을 가져야 한다(I7)"
    },
    {
      "id": "K14",
      "rule": "realizes가 accepted이려면 구획에 본문 지문(지문 규칙의 판 포함)이 있고 그 구획을 관측 근거로 가져야 한다. 원본 해시 일치는 판 동일성의 근거가 아니다"
    },
    {
      "id": "K15",
      "rule": "릴리스는 고정된 구성원 목록과 내용 해시를 가진다. 구성원이 없어지거나 제자리에서 바뀌면(해시 불일치) 위반이다. 릴리스가 읽는 주장은 목록에 있는 것뿐이다"
    }
  ]
}