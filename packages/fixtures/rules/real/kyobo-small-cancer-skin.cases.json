    { "id": "s14_already_paid", "set": {"already_paid": true},
      "expect": {"eligibility": "false", "payout": {"kind": "not_payable"}, "missing_inputs": []} },
    { "id": "s15_same_disease_flag_is_only_for_renewals", "set": {"is_renewal": false, "same_disease_paid_before_renewal": true},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 1000000}}, "missing_inputs": []} },
    { "id": "s16_odd_amount_year1_is_a_range", "note": "반올림 규칙 미기재: 10,000,001 × 0.1 = 1,000,000.1", "set": {"rider_amount_krw": 10000001},
