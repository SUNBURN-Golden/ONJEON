    { "id": "s17_odd_amount_after_year1_is_a_range", "note": "10,000,001 × 0.2 = 2,000,000.2", "set": {"rider_amount_krw": 10000001, "diagnosis_date": "2027-01-01"},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "range", "min_krw": 2000000, "max_krw": 2000001}}, "missing_inputs": []} }
