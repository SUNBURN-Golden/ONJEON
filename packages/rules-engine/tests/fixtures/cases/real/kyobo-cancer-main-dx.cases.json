      "set": {
        "beneficiary_harm_excludes_payout": null,
        "already_paid": true
      },
      "expect": {
        "eligibility": "false",
        "payout": {
          "kind": "not_payable"
        },
        "missing_inputs": []
      }
    },
    {
      "id": "k23_contractor_harm_unknown",
