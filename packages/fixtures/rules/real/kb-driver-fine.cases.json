           "has_other_contracts": false, "pro_rata_amount_krw": null},
  "cases": [
    { "id": "f01_under_cap", "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 15000000}}, "missing_inputs": []} },
