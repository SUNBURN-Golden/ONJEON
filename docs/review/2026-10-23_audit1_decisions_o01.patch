+"""O01 closure must retain the scope already approved by ADR-0018."""
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+class O01DecisionTests(unittest.TestCase):
+    def setUp(self):
+        text = (ROOT / "docs/blueprint/DECISIONS.md").read_text(encoding="utf-8")
+        self.rows = text.splitlines()
+        matches = [line for line in self.rows if line.startswith("| O01 |")]
+        self.assertEqual(1, len(matches))
+        self.row = matches[0]
+
+    def test_o01_is_closed_with_existing_decision_references(self):
+        self.assertIn("~~공제·우체국보험의 포함 여부~~", self.row)
+        self.assertIn("D19", self.row)
+        self.assertIn("ADR-0018 §4", self.row)
+        self.assertIn("전체 기관·소스 목록 작성 자체는 구현 작업(D11)", self.row)
+
+    def test_o01_preserves_approved_scope(self):
+        self.assertIn("우체국보험 포함(기관 유형 구분)", self.row)
+        self.assertIn("공제 제외(확보율 분모에서도 제외)", self.row)
+        d19 = next(line for line in self.rows if line.startswith("| D19 |"))
+        self.assertIn("우체국보험(기관 유형 구분)", d19)
+        self.assertIn("공제(분모에서도 제외)", d19)
+
+
+if __name__ == "__main__":
+    unittest.main()
