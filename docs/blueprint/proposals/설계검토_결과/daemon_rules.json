{
  "_status": "설계 담당 검토용 묶음. 채택된 정본이 아니다. 데몬 규칙 초안. 어떤 실행기·스케줄러·자동 병합에도 연결하지 않았다",
  "_author": "설계 담당 역할(Fable)로 지정된 하위 에이전트. 자기 보고 모델명은 증명이 아니다",
  "_decided_by": "역할·전환 정책은 사용자 결정 2026-10-12(U-04, 운영 규칙 1~8). 상태 기계·신호·봉투·잠금은 설계 담당 판단(감리 대상)",
  "schema": "onjeon-daemon-rules-0.1",
  "auto_merge": false,
  "daemon_identity": {
    "role": "messenger",
    "name": "Grokbot",
    "principle": "정해진 규칙에 따라 호출·전달·상태 기록·인계만 한다. 규칙에 없는 판단은 담당자에게 반송한다"
  },
  "roles": {
    "architect": {
      "primary": "Fable",
      "backup": "GPT Astra",
      "backup_trigger": [
        "usage_limit",
        "service_unavailable"
      ]
    },
    "auditor": {
      "primary": "Fable",
      "backup": "GPT Astra",
      "self_written_rule": "감리 담당이 직접 작성한 변경은 다른 계열이 검토한다"
    },
    "builders": [
      {
        "order": 1,
        "name": "Sonnet",
        "runner": "claude-code",
        "family": "claude"
      },
      {
        "order": 2,
        "name": "Cursor CLI(Grok 4.7)",
        "runner": "cursor-agent",
        "family": "grok"
      },
      {
        "order": 3,
        "name": "grokbuild CLI(Grok 4.7)",
        "runner": "grokbuild",
        "family": "grok"
      },
      {
        "order": 4,
        "name": "Devin CLI(SWE2)",
        "runner": "devin",
        "family": "swe"
      },
      {
        "order": 5,
        "name": "Claude Code(GLM 5.3)",
        "runner": "claude-code-glm",
        "family": "glm"
      }
    ],
    "after_last_builder": "paused_no_builder (작업 보존 후 대기. 다른 모델로 대체하지 않는다)",
    "reviewers": {
      "order": "builders와 같다",
      "exclude": "해당 PR 작성에 참여한 모든 계열(authors_families)",
      "if_none": "merge_wait(reason=reviewer_unavailable). 병합을 기다린다"
    },
    "families": {
      "claude": [
        "Fable",
        "Sonnet"
      ],
      "gpt": [
        "GPT Astra"
      ],
      "grok": [
        "Cursor CLI(Grok 4.7)",
        "grokbuild CLI(Grok 4.7)"
      ],
      "swe": [
        "Devin CLI(SWE2)"
      ],
      "glm": [
        "Claude Code(GLM 5.3)"
      ]
    },
    "_families_note": "Fable·Sonnet을 같은 claude 계열로 보는 것과 GLM을 실행 경로가 아니라 모델로 세는 것은 구현자 해석(자동개발_설정안 §3.3)이며 사용자 확인 대상이다. 그 전까지 데몬은 이 표를 그대로 쓴다(더 엄격한 쪽)",
    "merge": {
      "by": "human_only",
      "daemon_may_call_merge_api": false,
      "daemon_may_enable_auto_merge": false
    }
  },
  "states": {
    "queued": "실행 가능. 선행 과제 merged, prereq_decisions 비어 있음 또는 해당 결정 기록 있음",
    "blocked": "prereq_tasks 미병합 또는 prereq_decisions 미결. 사유 필드에 ID를 적는다",
    "leased": "빌더에게 임대됨(lease_id, TTL). 아직 쓰기 전",
    "building": "빌더가 브랜치에 쓰는 중. 하트비트 필요",
    "handoff": "전환 신호 감지. 쓰기 중단·보존 진행 중",
    "paused_no_builder": "모든 빌더 불가. 작업 보존 후 대기",
    "pr_open": "PR 열림. CI 대기",
    "ci_failed": "CI 실패. 같은 작성자가 고친다(전환 금지)",
    "review_pending": "리뷰어 배정 대기",
    "review_in_progress": "리뷰어가 대상 SHA에 고정해 리뷰 중",
    "changes_requested": "지적 있음. 같은 작성자가 수정. 새 SHA면 변경분 재리뷰",
    "review_approved": "독립 리뷰 통과(SHA 고정)",
    "audit_pending": "즉시 감리 대상. 감리 담당 응답 대기(병합 전)",
    "merge_wait": "사람 병합 대기. 사유: ready | reviewer_unavailable | auditor_unavailable | decision_pending",
    "merged": "사람이 병합함(데몬은 관측만)",
    "audit_queued": "정기 감리(10개 카운터) 묶음에 포함됨",
    "done": "완료 기준 전부 확인 + 감리 통과 또는 정기 감리 대기 상태로 종료",
    "returned": "데몬이 판단할 수 없어 담당자에게 반송. return_code 필수",
    "cancelled": "담당자가 취소"
  },
  "transitions": [
    {
      "from": "blocked",
      "to": "queued",
      "when": "all(prereq_tasks state==merged) and all(prereq_decisions in decisions_recorded)",
      "by": "daemon"
    },
    {
      "from": "queued",
      "to": "leased",
      "when": "builder_available and no_conflict_lease(conflict_paths) and lock_acquired(task_id)",
      "by": "daemon"
    },
    {
      "from": "leased",
      "to": "building",
      "when": "instruction_envelope_delivered and first_heartbeat",
      "by": "daemon"
    },
    {
      "from": "building",
      "to": "handoff",
      "when": "switch_signal in allowed_switch_signals",
      "by": "daemon"
    },
    {
      "from": "building",
      "to": "returned",
      "when": "result_envelope.touched_paths outside allowed_paths or result_envelope.verdict_requested or heartbeat_missing(lease_ttl) twice",
      "by": "daemon"
    },
    {
      "from": "handoff",
      "to": "leased",
      "when": "preserved(wip_commit_sha pushed, handoff_record written) and next_builder_available",
      "by": "daemon"
    },
    {
      "from": "handoff",
      "to": "paused_no_builder",
      "when": "preserved and no next builder",
      "by": "daemon"
    },
    {
      "from": "paused_no_builder",
      "to": "leased",
      "when": "any builder_available (사람이 환경을 고친 뒤)",
      "by": "daemon"
    },
    {
      "from": "building",
      "to": "pr_open",
      "when": "result_envelope.status==pr_opened and pr.body has task_id, authors, target_sha, test_log_ref",
      "by": "daemon"
    },
    {
      "from": "pr_open",
      "to": "ci_failed",
      "when": "ci.conclusion==failure",
      "by": "daemon"
    },
    {
      "from": "ci_failed",
      "to": "building",
      "when": "same author re-leased (전환 금지: 운영 규칙 1)",
      "by": "daemon"
    },
    {
      "from": "pr_open",
      "to": "review_pending",
      "when": "ci.conclusion==success",
      "by": "daemon"
    },
    {
      "from": "review_pending",
      "to": "review_in_progress",
      "when": "reviewer_assigned (family not in authors_families)",
      "by": "daemon"
    },
    {
      "from": "review_pending",
      "to": "merge_wait",
      "when": "no reviewer outside authors_families is available (reason=reviewer_unavailable)",
      "by": "daemon"
    },
    {
      "from": "review_in_progress",
      "to": "changes_requested",
      "when": "review_result.verdict==changes_requested",
      "by": "reviewer"
    },
    {
      "from": "review_in_progress",
      "to": "review_approved",
      "when": "review_result.verdict==approved and review_result.sha==pr.head_sha",
      "by": "reviewer"
    },
    {
      "from": "changes_requested",
      "to": "building",
      "when": "same author re-leased",
      "by": "daemon"
    },
    {
      "from": "review_approved",
      "to": "review_pending",
      "when": "pr.head_sha != review_result.sha (코드가 바뀜 → 변경분 재리뷰)",
      "by": "daemon"
    },
    {
      "from": "review_approved",
      "to": "audit_pending",
      "when": "immediate_audit_required(pr)",
      "by": "daemon"
    },
    {
      "from": "review_approved",
      "to": "merge_wait",
      "when": "not immediate_audit_required(pr) (reason=ready)",
      "by": "daemon"
    },
    {
      "from": "audit_pending",
      "to": "merge_wait",
      "when": "audit_result.verdict==pass and audit_result.sha==pr.head_sha (reason=ready)",
      "by": "auditor"
    },
    {
      "from": "audit_pending",
      "to": "changes_requested",
      "when": "audit_result.verdict==changes_requested",
      "by": "auditor"
    },
    {
      "from": "audit_pending",
      "to": "merge_wait",
      "when": "auditor unavailable (reason=auditor_unavailable)",
      "by": "daemon"
    },
    {
      "from": "merge_wait",
      "to": "merged",
      "when": "pr.merged==true observed (사람이 병합)",
      "by": "human"
    },
    {
      "from": "merged",
      "to": "audit_queued",
      "when": "pr is implementation PR → merged_impl_counter += 1",
      "by": "daemon"
    },
    {
      "from": "audit_queued",
      "to": "done",
      "when": "audit_result for batch containing this PR == pass",
      "by": "auditor"
    },
    {
      "from": "*",
      "to": "returned",
      "when": "any condition not covered by this table",
      "by": "daemon"
    },
    {
      "from": "*",
      "to": "cancelled",
      "when": "owner instruction",
      "by": "human"
    }
  ],
  "switch_policy": {
    "allowed_switch_signals": [
      {
        "id": "usage_limit",
        "detect": [
          "http_status==429",
          "stderr matches /(usage|rate) ?limit|quota|exceeded your/i",
          "runner exit code documented as limit"
        ]
      },
      {
        "id": "auth_failure",
        "detect": [
          "http_status in (401,403)",
          "stderr matches /not (logged|signed) in|unauthorized|invalid (api )?key|expired token/i"
        ]
      },
      {
        "id": "service_unavailable",
        "detect": [
          "http_status>=500",
          "connection refused/reset",
          "3 consecutive timeouts with no output within timeout_s"
        ]
      },
      {
        "id": "runner_missing",
        "detect": [
          "command not found",
          "version check fails"
        ]
      }
    ],
    "forbidden_switch_reasons": [
      "test_failure",
      "ci_failed",
      "review_findings",
      "audit_findings",
      "quality_dissatisfaction",
      "slow_progress"
    ],
    "handoff_steps": [
      "쓰기 중단 확인(마지막 쓰기 시각 기록)",
      "미커밋 변경을 같은 브랜치의 WIP 커밋으로 남기고 푸시(wip_commit_sha)",
      "시험 결과 로그 위치·남은 작업 목록을 handoff_record에 적는다",
      "다음 순위 빌더가 같은 브랜치·같은 SHA에서 시작한다",
      "authors_families에 새 계열을 추가한다(리뷰 제외 갱신)"
    ],
    "no_silent_substitution": true
  },
  "review_assignment": {
    "candidates": "builders 순서",
    "exclude_rule": "candidate.family in pr.authors_families → 제외",
    "pin": "review_result.sha == pr.head_sha 여야 유효. 다르면 변경분 재리뷰",
    "none_available": "merge_wait(reviewer_unavailable). 데몬은 리뷰를 대신하지 않는다",
    "self_review_forbidden": true
  },
  "audit_triggers": {
    "periodic": {
      "counter": "merged_impl_counter",
      "every": 10,
      "scope": "그 10개 PR의 누적 영향",
      "counts_only": "implementation PR(코드·스키마·시험 변경). 문서만 바꾼 PR은 세지 않는다(label docs-only 또는 변경 경로가 docs/** 뿐)"
    },
    "immediate_rules": [
      {
        "id": "path",
        "rule": "pr.changed_paths intersects immediate_audit_paths"
      },
      {
        "id": "task",
        "rule": "task.immediate_audit == true"
      },
      {
        "id": "label",
        "rule": "pr.labels intersects ['boundary', 'calc-semantics', 'contract', 'release-structure']"
      },
      {
        "id": "body",
        "rule": "pr.body contains '즉시 감리' marker"
      }
    ],
    "immediate_audit_paths": [
      "packages/schemas/**",
      "packages/rules-engine/src/**",
      "packages/ontology/**",
      "packages/twin-runtime/**",
      "services/personal/**",
      "services/knowledge/release/**",
      "services/ai-review/src/review/**",
      "infra/db/**",
      "infra/r2/**",
      "tools/r2_budget.py",
      "packages/schemas/ontology/tbox.json",
      "infra/ci/**"
    ],
    "design_change_audit": "01~06 문서의 구조·계약을 바꾸는 PR, T-box(C-20) 변경, D-09·D-10·D-15 확정 시",
    "stage_gate_audit": [
      "S0",
      "S1",
      "S2",
      "S3",
      "S4",
      "S5"
    ],
    "final_audit": "T-OP-08"
  },
  "envelopes": {
    "instruction": {
      "required": [
        "envelope_id",
        "task_id",
        "attempt",
        "lease_id",
        "builder",
        "runner",
        "branch",
        "base_sha",
        "allowed_paths",
        "forbidden_paths",
        "inputs",
        "tests",
        "done_criteria",
        "deadline_heartbeat_s",
        "budget",
        "reply_to"
      ],
      "budget": {
        "max_calls": "int",
        "max_cost_units": "int",
        "max_wall_s": "int",
        "max_retries": "int"
      },
      "rules_for_builder": [
        "allowed_paths 밖을 바꾸지 않는다",
        "정본·토의 자료를 바꾸지 않는다",
        "비밀값을 출력하지 않는다",
        "판단이 필요하면 verdict_requested로 반송한다",
        "병합·자동 병합 설정을 하지 않는다"
      ]
    },
    "result": {
      "required": [
        "envelope_id",
        "task_id",
        "attempt",
        "lease_id",
        "builder",
        "runner",
        "status",
        "branch",
        "head_sha",
        "touched_paths",
        "tests_run",
        "test_log_ref",
        "signals_seen",
        "cost_units",
        "calls",
        "wall_s"
      ],
      "status_values": [
        "pr_opened",
        "wip_preserved",
        "switch_signal",
        "verdict_requested",
        "failed_tests",
        "completed_no_change"
      ],
      "optional": [
        "pr_number",
        "verdict_question",
        "handoff_record"
      ]
    },
    "review_result": {
      "required": [
        "pr_number",
        "sha",
        "reviewer",
        "reviewer_family",
        "runner",
        "verdict",
        "findings_ref"
      ]
    },
    "audit_result": {
      "required": [
        "batch_id or pr_number",
        "sha",
        "auditor",
        "verdict",
        "report_ref"
      ]
    }
  },
  "checkpoint_and_resume": {
    "state_store": "작업별 상태 파일(JSON, append-only 이벤트 로그 + 현재 상태 스냅샷). 비밀값 없음",
    "write_before_act": "외부 호출(빌더 실행·PR 생성) 전에 의도 레코드를 먼저 쓴다. 호출 뒤 결과 레코드를 쓴다",
    "resume": [
      "데몬 재시작 시 모든 임대를 읽는다",
      "의도 레코드만 있고 결과 레코드가 없으면 외부 상태(브랜치·PR)를 조회해 결과를 복원한다",
      "복원 불가면 임대를 해제하고 returned(resume_unresolved)로 둔다",
      "브랜치의 WIP 커밋은 지우지 않는다"
    ],
    "stop": "담당자 중단 지시 또는 예산 소진 시 새 임대를 만들지 않고 진행 중 임대는 하트비트 만료까지 둔다"
  },
  "concurrency": {
    "lease": {
      "ttl_s": "[사용자 결정 필요] 기본 3600",
      "heartbeat_s": 300,
      "renew": "하트비트마다 갱신. 두 번 놓치면 만료"
    },
    "idempotency_key": "task_id + attempt + base_sha. 같은 키의 지시 봉투는 다시 보내지 않는다",
    "single_writer": "같은 브랜치에 임대는 하나. 파일 잠금(상태 저장소)으로 강제",
    "conflict_paths": "tasks.json의 conflict_paths가 겹치는 과제는 동시에 임대하지 않는다",
    "max_parallel_leases": "[사용자 결정 필요] 기본 2",
    "branch_naming": "task/<task_id>-a<attempt>",
    "pr_dedup": "같은 task_id의 열린 PR이 있으면 새 PR을 만들지 않는다"
  },
  "daemon_does": [
    "상태 전이표에 있는 전이만 수행",
    "지시 봉투 생성·전달",
    "결과 봉투 수신·검증(필수 필드, 경로 범위)",
    "CI·PR·리뷰·감리 결과 관측과 기록",
    "전환 신호 판정(기계 검출만)",
    "리뷰어·감리 배정(배제 규칙)",
    "카운터·잠금·임대·멱등 키 관리",
    "인계 기록 보존",
    "반송"
  ],
  "daemon_does_not": [
    "병합",
    "자동 병합 설정",
    "리뷰·감리 판정",
    "시험 실패 원인 판단",
    "범위·완료 기준 변경",
    "모델 대체",
    "allowed_paths·forbidden_paths 수정",
    "비밀값 전달·출력",
    "정본·토의 자료 수정",
    "외부 문의 발송",
    "배포",
    "R2 토큰 보유",
    "요청에 없는 과제 생성"
  ],
  "return_codes": [
    {
      "code": "R-01",
      "when": "결과 봉투의 touched_paths가 allowed_paths 밖",
      "to": "architect"
    },
    {
      "code": "R-02",
      "when": "빌더가 verdict_requested(설계·제품·리뷰 판단 요청)",
      "to": "architect 또는 user"
    },
    {
      "code": "R-03",
      "when": "전환 신호가 allowed·forbidden 어느 목록에도 없음",
      "to": "user"
    },
    {
      "code": "R-04",
      "when": "리뷰·감리 결과의 sha가 head_sha와 다름",
      "to": "reviewer/auditor"
    },
    {
      "code": "R-05",
      "when": "prereq_decisions에 적힌 결정 ID가 결정 기록에 없음",
      "to": "user"
    },
    {
      "code": "R-06",
      "when": "같은 과제 3회 연속 failed_tests",
      "to": "architect (전환 아님)"
    },
    {
      "code": "R-07",
      "when": "예산(호출·비용·시간) 소진",
      "to": "user"
