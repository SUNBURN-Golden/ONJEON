{
  "rule_id": "kyobo-cancer-main-dx",
  "source": "교보통합암보험(무배당) 2026.06.29 판매본 약관 제7조·제8조⑥·제9조·제26조⑤·별표1 (주)3·4. 경계값은 약관 문장에서 직접 만든 것이며 보험사 지급 사례가 아니다. AI 해석·미검수.",
  "base": {"contract_date": "2026-01-01", "is_revived": false, "revival_date": null, "diagnosis_date": "2026-06-01", "policy_end_date": "2086-01-01",
           "dx_in_cancer_annex_at_dx": true, "already_paid": false, "self_harm": false, "self_harm_without_free_will": false,
           "harmed_by_beneficiary_or_contractor": false, "insured_amount_krw": 30000000},
  "cases": [
    { "id": "k01_day90_still_waiting", "note": "계약일 포함 90일째(3-31)는 면책", "set": {"diagnosis_date": "2026-03-31"},
      "expect": {"eligibility": "false", "payout": {"kind": "not_payable"}, "missing_inputs": []} },
    { "id": "k02_next_day_covered_reduced", "note": "90일이 되는 날의 다음날(4-01)부터 보장, 1년 미만 50%", "set": {"diagnosis_date": "2026-04-01"},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 15000000}}, "missing_inputs": []} },
    { "id": "k03_last_reduced_day", "note": "1년이 되는 계약해당일의 전일까지 감액", "set": {"diagnosis_date": "2026-12-31"},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 15000000}}, "missing_inputs": []} },
    { "id": "k04_anniversary_full", "note": "계약해당일 당일부터 전액", "set": {"diagnosis_date": "2027-01-01"},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 30000000}}, "missing_inputs": []} },
    { "id": "k05_revival_moves_waiting_not_reduction", "note": "부활 시 면책 기산은 부활일, 감액 기산은 보험계약일 그대로",
      "set": {"is_revived": true, "revival_date": "2027-03-01", "diagnosis_date": "2027-05-15"},
      "expect": {"eligibility": "false", "payout": {"kind": "not_payable"}, "missing_inputs": []} },
    { "id": "k06_revival_after_waiting_full", "set": {"is_revived": true, "revival_date": "2027-03-01", "diagnosis_date": "2027-05-30"},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 30000000}}, "missing_inputs": []} },
    { "id": "k07_revival_unknown_date", "note": "부활했는데 부활일을 모르면 0원이 아니라 판단 불가", "set": {"is_revived": true, "revival_date": null},
      "expect": {"eligibility": "unknown", "payout": {"kind": "undetermined", "conditional_amount": {"kind": "exact", "krw": 15000000}}, "missing_inputs": ["revival_date"]} },
    { "id": "k08_small_cancer_not_main", "note": "기타피부암 등은 별표2 '암'에서 제외 → 주계약 지급 없음(소액암 특약 영역)", "set": {"dx_in_cancer_annex_at_dx": false},
      "expect": {"eligibility": "false", "payout": {"kind": "not_payable"}, "missing_inputs": []} },
    { "id": "k09_code_unclassified", "note": "진단 코드가 진단 시점 KCD로 아직 분류되지 않음", "set": {"dx_in_cancer_annex_at_dx": null},
      "expect": {"eligibility": "unknown", "payout": {"kind": "undetermined", "conditional_amount": {"kind": "exact", "krw": 15000000}}, "missing_inputs": ["dx_in_cancer_annex_at_dx"]} },
    { "id": "k10_second_diagnosis", "set": {"already_paid": true},
      "expect": {"eligibility": "false", "payout": {"kind": "not_payable"}, "missing_inputs": []} },
    { "id": "k11_self_harm_excluded", "set": {"self_harm": true},
      "expect": {"eligibility": "false", "payout": {"kind": "not_payable"}, "missing_inputs": []} },
    { "id": "k12_self_harm_without_free_will_paid", "note": "제9조1호 단서", "set": {"self_harm": true, "self_harm_without_free_will": true},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 15000000}}, "missing_inputs": []} },
    { "id": "k13_odd_amount_rounding_unstated", "note": "약관이 반올림 규칙을 적지 않음 → 홀수 원은 범위", "set": {"insured_amount_krw": 10000001},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "range", "min_krw": 5000000, "max_krw": 5000001}}, "missing_inputs": []} },
    { "id": "k14_leap_day_contract", "note": "2-29 계약의 1년 계약해당일은 2-28로 처리(clamp). 약관 정의 확인 전 가정 → GAP G13",
      "set": {"contract_date": "2028-02-29", "diagnosis_date": "2029-02-28"},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 30000000}}, "missing_inputs": []} },
    { "id": "k15_after_policy_end", "set": {"diagnosis_date": "2086-01-02"},
      "expect": {"eligibility": "false", "payout": {"kind": "not_payable"}, "missing_inputs": []} }
  ]
}
