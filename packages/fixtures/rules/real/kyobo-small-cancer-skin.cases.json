    { "id": "s10_diagnosis_before_period_start", "set": {"period_start_date": "2026-06-02"},
      "expect": {"eligibility": "false", "payout": {"kind": "not_payable"}, "missing_inputs": []} },
    { "id": "s11_diagnosis_on_period_end", "set": {"period_end_date": "2026-06-01"},
      "expect": {"eligibility": "true", "payout": {"kind": "payable", "amount": {"kind": "exact", "krw": 1000000}}, "missing_inputs": []} },
    { "id": "s12_diagnosis_after_period_end", "set": {"period_end_date": "2026-05-31"},
